# Bỏ qua thư mục bộ nhớ đệm của Python hoặc Godot
__pycache__/
.godot/
*.pyc

# Bỏ qua tất cả các file có đuôi .log hoặc .tmp
*.log
*.tmp

# Bỏ qua file chứa mật khẩu, token cấu hình
.env

# Bỏ qua cấu hình riêng của từng máy (đường dẫn Maya, user Windows khác nhau)
.vscode/
.claude/settings.local.json

# Bỏ qua file rác do Windows tự tạo
Thumbs.db
desktop.ini
